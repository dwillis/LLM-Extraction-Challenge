#!/usr/bin/env python3
"""smevals runner: sends the task prompt to an `llm`-library model.

The JSON schema below is a verbatim copy of ../email_llm.py (lines 9-22).
Keep the two in sync -- if they diverge, scores from this eval stop being
comparable to the *_prompt2.json rows in the leaderboard.

Malformed model output is a model-quality failure, not a runner failure:
we print whatever the model returned to stdout and let the checker score
it. A non-zero exit here signals an infrastructure problem (bad API key,
unknown model, network error), which smevals records as a failed run.
"""
import os

import llm

SCHEMA = {
    "type": "object",
    "properties": {
        "committee": {
            "type": ["string", "null"],
            "description": "The name of the committee from the disclaimer (without 'Paid for by' prefix)",
        },
        "sender": {
            "type": ["string", "null"],
            "description": "The name of the person mentioned as the author of the email",
        },
    },
    "required": ["committee", "sender"],
}


def main():
    model = llm.get_model(os.environ["SMEVALS_MODEL"])
    response = model.prompt(os.environ["SMEVALS_PROMPT"], schema=SCHEMA)
    print(response.text())


if __name__ == "__main__":
    main()
