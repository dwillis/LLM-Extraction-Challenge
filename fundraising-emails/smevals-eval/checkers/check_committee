#!/usr/bin/env python3
"""smevals checker: exact-match on the extracted committee.

Reproduces ../../matcher.py's normalization (fillna("none") -> str ->
lower -> strip) so scores here are comparable to that script's Accuracy
column. Sender is intentionally not scored here -- see check_sender.
"""
import json
import os
import sys


def norm(value):
    if value is None:
        return "none"
    s = str(value).lower().strip()
    return s if s else "none"


def main():
    run_dir = os.environ["SMEVALS_RUN_DIR"]
    gold = norm(os.environ.get("SMEVALS_TASK_COMMITTEE"))

    with open(os.path.join(run_dir, "output.txt"), encoding="utf-8") as f:
        raw = f.read()

    try:
        parsed = json.loads(raw)
        pred = norm(parsed.get("committee"))
        parse_ok = True
    except (json.JSONDecodeError, AttributeError):
        pred, parse_ok = "<unparseable>", False

    match = parse_ok and pred == gold
    print(json.dumps({
        "score": 1.0 if match else 0.0,
        "metrics": {"committee_match": match, "json_parse_ok": parse_ok},
        "notes": f"gold={gold!r} pred={pred!r}",
    }))
    sys.exit(0 if match else 1)


if __name__ == "__main__":
    main()
